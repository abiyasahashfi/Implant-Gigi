  /* Hero */
  .hero{padding:64px 0 80px;position:relative}
  .hero-grid{display:grid;grid-template-columns:1.05fr 0.95fr;gap:56px;align-items:center}
  .hero h1{font-size:47px;margin-bottom:22px;letter-spacing:-0.01em}
  .hero .sub{font-size:18px;color:var(--ink-soft);max-width:540px;margin-bottom:30px;font-weight:300}
  .hero-cta{display:flex;flex-wrap:wrap;gap:14px;align-items:center;margin-bottom:16px}
  .hero-note{font-size:13.5px;color:var(--ink-soft);display:flex;align-items:flex-start;gap:8px}
  .hero-note svg{color:var(--gold-deep);flex-shrink:0;margin-top:3px}
  .hero-link{
    display:inline-flex;align-items:center;gap:8px;margin-top:16px;
    font-size:13.5px;font-weight:500;color:var(--gold-deep);text-decoration:none;
    border-bottom:1px solid rgba(138,109,66,0.35);padding-bottom:3px;
  }
  .hero-link:hover{border-bottom-color:var(--gold-deep)}
  .hero-media{position:relative}
  .hero-media img{width:100%;border-radius:28px;box-shadow:var(--shadow);display:block;aspect-ratio:4/4.4;object-fit:cover}
  .hero-badge{
    position:absolute;left:-22px;bottom:28px;background:#fff;border-radius:18px;
    padding:16px 20px;box-shadow:var(--shadow-soft);display:flex;align-items:center;gap:14px;max-width:258px;
  }
  .hero-badge .pill{width:44px;height:44px;border-radius:12px;background:var(--cream);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--gold-deep)}
  .hero-badge b{font-family:var(--sans);font-weight:600;font-size:14px;display:block}
  .hero-badge small{font-size:12px;color:var(--ink-soft)}
  .hero-trust{display:flex;gap:28px;margin-top:34px;flex-wrap:wrap}
  .hero-trust .t{display:flex;flex-direction:column}
  .hero-trust .t b{font-family:var(--serif);font-size:26px;color:var(--gold-deep)}
  .hero-trust .t span{font-size:12.5px;color:var(--ink-soft);letter-spacing:0.02em}

  /* Section base */
  section.blk{padding:82px 0}
  .sec-head{max-width:760px;margin:0 auto 52px;text-align:center}
  .sec-head h2{font-size:40px;margin-bottom:16px}
  .sec-head p{color:var(--ink-soft);font-size:17px}

  /* Problem / Situasi */
  .problem{background:var(--cream)}
  .problem-inner{max-width:830px;margin:0 auto}
  .problem h2{font-size:38px;text-align:center;margin-bottom:28px}
  .problem p{font-size:17.5px;color:#4a4038;margin-bottom:20px}
  .problem .lead{font-size:19px;color:var(--ink)}
  .compare-list{list-style:none;margin:30px 0;display:flex;flex-direction:column;gap:14px}
  .compare-list li{
    background:var(--cream-soft);border:1px solid var(--line);border-radius:16px;
    padding:18px 22px;font-size:16px;color:#4a4038;display:flex;gap:14px;align-items:flex-start;
  }
  .compare-list li::before{content:"";flex-shrink:0;width:9px;height:9px;border-radius:50%;background:var(--gold);margin-top:9px}
  .problem .punch{
    font-family:var(--serif);font-size:24px;font-weight:600;color:var(--ink);
    text-align:center;margin:34px 0 22px;line-height:1.4;
