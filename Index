  .inset h3{font-family:var(--serif);font-size:25px;color:#fff;margin-bottom:16px;line-height:1.3}
  .inset p{font-size:16px;color:rgba(243,235,221,0.82);margin-bottom:14px}
  .inset p:last-child{margin-bottom:0}
  .inset .tagline{display:inline-flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:16px}

  /* Reframe */
  .reframe-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
  .reframe h2{font-size:38px;margin-bottom:24px}
  .reframe p{color:var(--ink-soft);font-size:17px;margin-bottom:20px}
  .diag-list{list-style:none;display:flex;flex-direction:column;gap:22px;margin-top:8px}
  .diag-list li{display:flex;gap:18px;align-items:flex-start}
  .diag-list .n{flex-shrink:0;width:40px;height:40px;border-radius:12px;background:var(--cream);color:var(--gold-deep);display:flex;align-items:center;justify-content:center}
  .diag-list b{font-family:var(--sans);font-weight:600;font-size:16px;display:block;margin-bottom:4px;color:var(--ink)}
  .diag-list span{font-size:15px;color:var(--ink-soft);line-height:1.6}
  .reframe-quote{
    background:linear-gradient(135deg,#2F2823,#211b17);color:#F3EBDD;border-radius:24px;
    padding:44px 40px;box-shadow:var(--shadow);
  }
  .reframe-quote .mark{font-family:var(--serif);font-size:64px;line-height:0.5;color:var(--gold);display:block;margin-bottom:18px;height:32px}
  .reframe-quote p{font-family:var(--serif);font-size:23px;font-style:italic;color:#F7F0E4;line-height:1.5;font-weight:500}

  /* Kelayakan */
  .elig{background:var(--cream)}
  .elig-list{max-width:880px;margin:0 auto;display:flex;flex-direction:column;gap:18px}
  .elig-item{
    background:var(--card);border:1px solid rgba(42,36,32,0.05);border-left:4px solid var(--gold);
    border-radius:22px;padding:32px 36px;box-shadow:var(--shadow-soft);
  }
  .elig-item.wait{border-left-color:#C9A24A}
  .elig-item.no{border-left-color:var(--gold-deep)}
  .elig-item .st{font-size:11px;letter-spacing:0.16em;text-transform:uppercase;font-weight:600;color:var(--gold-deep);margin-bottom:10px;display:block}
  .elig-item h3{font-size:22px;margin-bottom:14px;line-height:1.3}
  .elig-item p{font-size:16px;color:var(--ink-soft);margin-bottom:12px}
  .elig-item p:last-child{margin-bottom:0}
  .elig-close{max-width:880px;margin:34px auto 0;text-align:center;font-family:var(--serif);font-size:20px;font-style:italic;color:var(--gold-deep);line-height:1.5}

  /* Process */
  .proc-grid{display:grid;grid-template-columns:0.9fr 1.1fr;gap:56px;align-items:center}
  .proc-media img{width:100%;border-radius:24px;box-shadow:var(--shadow);aspect-ratio:4/4.6;object-fit:cover}
  .steps{list-style:none;display:flex;flex-direction:column;gap:8px}
  .step{display:flex;gap:22px;padding:18px 0;border-bottom:1px solid var(--line)}
  .step:last-child{border-bottom:none}
  .step .num{flex-shrink:0;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#C0A06E,#8A6D42);color:#fff;font-family:var(--serif);font-size:18px;display:flex;align-items:center;justify-content:center}
  .step b{font-family:var(--sans);font-weight:600;font-size:16.5px;display:block;margin-bottom:4px}
  .step span{font-size:14.5px;color:var(--ink-soft)}
  .step .free-tag{display:inline-block;margin-top:6px;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;color:var(--gold-deep);background:rgba(184,153,104,0.14);padding:4px 11px;border-radius:999px}
  .alt-path{background:var(--cream);border:1px solid var(--line);border-radius:20px;padding:26px 30px;margin-top:30px}
  .alt-path b{font-family:var(--sans);font-weight:600;font-size:16px;display:block;margin-bottom:10px;color:var(--ink)}
  .alt-path p{font-size:15px;color:var(--ink-soft);margin-bottom:10px}
  .alt-path p:last-child{margin-bottom:0}

  /* Social proof */
  .proof{background:linear-gradient(180deg,#2F2823,#221c18);color:#F3EBDD}
  .proof .sec-head h2{color:#fff}
  .proof .sec-head p{color:rgba(243,235,221,0.7)}
  .proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:44px}
  .ba-card{background:rgba(255,255,255,0.04);border:1px solid rgba(243,235,221,0.12);border-radius:22px;overflow:hidden}
  .ba-ph{aspect-ratio:1/1;background:repeating-linear-gradient(135deg,rgba(243,235,221,0.06),rgba(243,235,221,0.06) 12px,rgba(243,235,221,0.03) 12px,rgba(243,235,221,0.03) 24px);display:flex;flex-direction:column;align-items:center;justify-content:center;color:rgba(243,235,221,0.5);gap:10px;text-align:center;padding:20px}
  .ba-ph svg{opacity:0.5}
  .ba-ph small{font-size:12px;letter-spacing:0.05em}
  .ba-card .cap{padding:20px 22px}
  .ba-card .cap .tt{font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:8px;display:block}
  .ba-card .cap p{font-size:14.5px;color:#EAE0CF}
  .proof-badges{display:flex;justify-content:center;gap:14px;flex-wrap:wrap}
  .p-badge{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,0.06);border:1px solid rgba(243,235,221,0.14);padding:12px 22px;border-radius:999px;font-size:14px;font-weight:500}
  .p-badge .stars{color:var(--gold)}

  /* Doctor & clinic */
  .doc-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;margin-bottom:56px}
  .doc-card{background:var(--card);border-radius:24px;padding:36px;box-shadow:var(--shadow-soft);border:1px solid rgba(42,36,32,0.05)}
  .doc-card .role{font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--gold-deep);font-weight:600;margin-bottom:10px;display:block}
  .doc-card h3{font-size:25px;margin-bottom:8px}
  .doc-card .spec{font-size:14.5px;color:var(--gold-deep);font-weight:500;margin-bottom:0}
  .doc-intro{max-width:820px;margin:0 auto 40px;text-align:center}
  .doc-intro p{font-size:16.5px;color:var(--ink-soft);margin-bottom:16px}
  .doc-skill{list-style:none;max-width:820px;margin:0 auto 48px;display:flex;flex-direction:column;gap:16px}
  .doc-skill li{display:flex;gap:16px;align-items:flex-start;font-size:16px;color:var(--ink-soft)}
  .doc-skill li::before{content:"";flex-shrink:0;width:22px;height:22px;border-radius:50%;background:var(--cream);border:1px solid rgba(184,153,104,.45);margin-top:3px}
  .doc-owners{font-size:15.5px;color:var(--ink-soft);max-width:560px;margin:0 auto 18px;text-align:center}
  .gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:40px}
  .gallery img{width:100%;height:100%;border-radius:18px;object-fit:cover;box-shadow:var(--shadow-soft);aspect-ratio:1/1.15}
  .gallery .g-wide{grid-column:span 2;aspect-ratio:2/1.15}

  /* Pilihan Perawatan */
  .options{background:var(--cream)}
  .opt-inner{max-width:860px;margin:0 auto;text-align:center}
  .opt-chips{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin:32px 0 30px}
  .opt-chips span{background:var(--cream-soft);border:1px solid var(--line);border-radius:999px;padding:12px 24px;font-size:14.5px;font-weight:500;color:var(--ink)}
  .opt-inner > p{font-size:17px;color:#4a4038;margin-bottom:18px}
  .opt-note{background:var(--cream-soft);border-left:3px solid var(--gold);border-radius:14px;padding:22px 26px;text-align:left;margin:26px 0 28px}
  .opt-note p{font-size:16px;color:#4a4038;margin-bottom:10px}
  .opt-note p:last-child{margin-bottom:0}
  .options .free{font-family:var(--serif);font-size:20px;font-style:italic;color:var(--gold-deep);line-height:1.5;margin-bottom:30px}

  /* FAQ */
  .faq-grid{max-width:830px;margin:0 auto;display:flex;flex-direction:column;gap:14px}
  .faq-item{background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:box-shadow .25s}
  .faq-q{padding:22px 26px;font-family:var(--sans);font-weight:600;font-size:16.5px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:18px;color:var(--ink);list-style:none}
  .faq-q::-webkit-details-marker{display:none}
  .faq-q .plus{flex-shrink:0;width:26px;height:26px;position:relative;transition:transform .3s}
  .faq-q .plus::before,.faq-q .plus::after{content:"";position:absolute;background:var(--gold-deep);border-radius:2px}
  .faq-q .plus::before{top:50%;left:4px;right:4px;height:2px;transform:translateY(-50%)}
  .faq-q .plus::after{left:50%;top:4px;bottom:4px;width:2px;transform:translateX(-50%);transition:opacity .3s}
  details[open] .faq-q .plus::after{opacity:0}
  details[open] .faq-q .plus{transform:rotate(180deg)}
  .faq-a{padding:0 26px 24px;font-size:15.5px;color:var(--ink-soft);line-height:1.7}
  .faq-a ol{margin:12px 0 0 20px;display:flex;flex-direction:column;gap:8px}
  .faq-a li{font-size:15.5px}

  /* Final CTA */
  .final{position:relative;padding:96px 0;text-align:center;overflow:hidden}
  .final::before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,#2F2823,#211b17);z-index:-2}
  .final-inner{max-width:700px;margin:0 auto;color:#F3EBDD}
  .final h2{font-size:42px;color:#fff;margin-bottom:24px}
  .final p{font-size:18px;color:rgba(243,235,221,0.82);margin-bottom:14px}
  .final .strong{color:#fff;font-weight:500}
  .final .btn{margin:30px 0 22px;padding:18px 40px;font-size:16px}
  .final-info{font-size:14px;color:rgba(243,235,221,0.7);line-height:1.9}
  .final-info b{color:#F3EBDD;font-weight:500}

  /* Footer */
  footer{background:#211b17;color:rgba(243,235,221,0.75);padding:54px 0 30px}
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;padding-bottom:36px;border-bottom:1px solid rgba(243,235,221,0.12)}
  .foot-logo b{font-family:var(--sans);font-weight:600;font-size:22px;letter-spacing:0.05em;color:#F3EBDD}
  .foot-logo span{font-size:11px;letter-spacing:0.35em;display:block;margin-top:2px}
  .foot-grid p{font-size:14px;margin-top:14px;max-width:290px}
  .foot-col h4{font-family:var(--sans);font-size:13px;letter-spacing:0.12em;text-transform:uppercase;color:#F3EBDD;margin-bottom:16px;font-weight:600}
  .foot-col a,.foot-col p{color:rgba(243,235,221,0.75);text-decoration:none;display:block;font-size:14px;margin-bottom:10px;margin-top:0}
  .foot-col a:hover{color:var(--gold)}
  .foot-bottom{padding-top:24px;font-size:13px;color:rgba(243,235,221,0.5);text-align:center}

  /* WA float */
  .wa-float{position:fixed;right:22px;bottom:22px;z-index:60;width:60px;height:60px;border-radius:50%;background:#25D366;box-shadow:0 10px 30px -6px rgba(37,211,102,0.6);display:flex;align-items:center;justify-content:center;transition:transform .25s}
  .wa-float:hover{transform:scale(1.08)}
  .wa-float svg{width:32px;height:32px;fill:#fff}

  /* Responsive */
  @media(max-width:900px){
    .hero-grid,.reframe-grid,.proc-grid,.doc-grid{grid-template-columns:1fr;gap:40px}
    .proof-grid{grid-template-columns:1fr}
    .hero h1{font-size:40px}
    .sec-head h2,.problem h2,.reframe h2,.final h2{font-size:32px}
    .hero-media{order:-1}
    .reframe-quote{order:2}
    .gallery{grid-template-columns:repeat(2,1fr)}
    .gallery .g-wide{grid-column:span 2}
    .nav-rating{display:none}
  }
  @media(max-width:560px){
    .wrap{padding:0 18px}
    .hero{padding:44px 0 60px}
    .hero h1{font-size:34px}
    .hero .sub{font-size:16.5px}
    section.blk{padding:60px 0}
    .sec-head h2,.problem h2,.reframe h2,.final h2{font-size:27px}
    .hero-cta .btn{width:100%}
    .hero-badge{left:0;right:0;margin:16px auto 0;position:relative;bottom:auto;max-width:100%}
    .gallery{grid-template-columns:1fr 1fr}
    .doc-card{padding:28px}
    .elig-item{padding:26px 24px}
    .inset{padding:30px 26px}
    .final h2{font-size:28px}
    .foot-grid{grid-template-columns:1fr;gap:28px}
    .nav .logo span{display:none}
  }
</style>
</head>
